{
  "expo": {
    "name": "PataFundi Fundi",
    "slug": "patafundi-fundi",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "patafundi-fundi",
    "userInterfaceStyle": "automatic",
    "splash": { "image": "./assets/splash.png", "resizeMode": "contain", "backgroundColor": "#0F172A" },
    "updates": { "enabled": false, "checkAutomatically": "ON_ERROR_RECOVERY", "fallbackToCacheTimeout": 0 },
    "runtimeVersion": { "policy": "sdkVersion" },
    "jsEngine": "hermes",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.patafundi.fundi",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "PataFundi needs your location to match you with nearby jobs and track your arrival.",
        "NSLocationAlwaysAndWhenInUseUsageDescription": "PataFundi needs background location during active jobs to track your arrival.",
        "NSCameraUsageDescription": "Take job completion photos."
      }
    },
    "android": {
      "adaptiveIcon": { "foregroundImage": "./assets/adaptive-icon.png", "backgroundColor": "#0F172A" },
      "package": "com.patafundi.fundi",
      "permissions": ["ACCESS_FINE_LOCATION", "ACCESS_COARSE_LOCATION", "ACCESS_BACKGROUND_LOCATION", "CAMERA"]
    },
    "extra": {
      "API_URL": "https://patafundi-9bhsw1.onrender.com",
      "SOCKET_URL": "https://patafundi-9bhsw1.onrender.com"
    },
    "plugins": ["expo-location", "expo-font"]
  }
}
