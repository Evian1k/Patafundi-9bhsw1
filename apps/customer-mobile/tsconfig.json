{
  "compilerOptions": {
    "strict": true,
    "jsx": "react-jsx",
    "esModuleInterop": true,
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "allowSyntheticDefaultImports": true,
    "baseUrl": ".",
    "typeRoots": ["./node_modules/@types"],
    "paths": {
      "@patafundi/shared": [
        "../../packages/shared/src/index.ts"
      ],
      "@react-native-async-storage/async-storage": ["./node_modules/@react-native-async-storage/async-storage"],
      "@expo/vector-icons": ["./node_modules/@expo/vector-icons"],
      "expo-linear-gradient": ["./node_modules/expo-linear-gradient"],
      "expo-secure-store": ["./node_modules/expo-secure-store"],
      "react": ["./node_modules/@types/react/index.d.ts"],
      "react/*": ["./node_modules/@types/react/*"],
      "react-native": ["./node_modules/react-native"],
      "socket.io-client": ["./node_modules/socket.io-client"]
    }
  },
  "extends": "expo/tsconfig.base",
  "include": [
    "**/*.ts",
    "**/*.tsx",
    ".expo/types/**/*.ts",
    "expo-env.d.ts"
  ]
}
