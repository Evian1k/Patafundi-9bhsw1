{
  "expo": {
    "name": "PataFundi",
    "slug": "patafundi-customer",
    "version": "1.0.0",
    "sdkVersion": "54.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#0F172A"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.patafundi.customer",
      "buildNumber": "1",
      "infoPlist": {
        "NSCameraUsageDescription": "Allow PataFundi to access your camera for profile photos and job documentation",
        "NSLocationWhenInUseUsageDescription": "Allow PataFundi to access your location to find nearby fundis and provide accurate service",
        "NSPhotoLibraryUsageDescription": "Allow PataFundi to access your photo library for profile photos and job documentation"
      }
    },
    "android": {
      "package": "com.patafundi.customer",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0F172A"
      },
      "permissions": [
        "CAMERA",
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION",
        "READ_EXTERNAL_STORAGE",
        "WRITE_EXTERNAL_STORAGE",
        "POST_NOTIFICATIONS"
      ]
    },
    "scheme": "patafundi-customer",
    "plugins": [
      "expo-location"
    ],
    "extra": {
      "apiBaseUrl": "https://patafundi-9bhsw1.onrender.com",
      "privacyPolicyUrl": "https://patafundi-9bhsw1.vercel.app/privacy",
      "termsUrl": "https://patafundi-9bhsw1.vercel.app/terms",
      "supportEmail": "support@patafundi.com"
    },
    "experiments": {
      "typedRoutes": true
    }
  }
}
