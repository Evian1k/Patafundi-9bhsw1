# Local Compose values only. Copy to deploy/compose/.env and replace each value.
# Keep POSTGRES_PASSWORD URL-safe (letters and numbers) because it is embedded
# in DATABASE_URL by docker-compose.yml. Generate secrets with:
# node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
POSTGRES_USER=patafundi
POSTGRES_PASSWORD=replace_with_random_url_safe_password
POSTGRES_DB=patafundi_dev
JWT_SECRET=replace_with_random_secret
REFRESH_TOKEN_SECRET=replace_with_another_random_secret
ENCRYPTION_KEY=replace_with_random_encryption_key
