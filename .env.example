# PataFundi Environment Variables

# ── Frontend (Vite) ────────────────────────────────────────────────────────────
# Local dev: leave empty to use Vite proxy (/api → http://127.0.0.1:4000)
# Production / Vercel: set to your Render backend origin (no trailing slash required)
VITE_API_URL=
# Socket.IO — auto-derived from VITE_API_URL if omitted; set explicitly for production
VITE_SOCKET_URL=

# Location provider: false = OpenStreetMap (free), true = Google Maps (requires keys below)
VITE_USE_GOOGLE_MAPS=false

# Google Maps (client-side maps rendering)
VITE_GOOGLE_MAPS_API_KEY=

# Production (Vercel env vars + .env.production for local builds):
# VITE_API_URL=https://patafundi-9bhsw1.onrender.com
# VITE_SOCKET_URL=https://patafundi-9bhsw1.onrender.com

# ── Backend (Render / local) ─────────────────────────────────────────────────
PORT=4000
# Primary frontend URL (your Vercel deployment)
FRONTEND_ORIGIN=http://127.0.0.1:8080
# Production Render: https://patafundi.vercel.app
# Extra allowed origins, comma-separated
CORS_ORIGINS=

# PostgreSQL — REQUIRED on Windows (PGlite embedded DB may crash on Windows).
#
# OPTION A — Free cloud Postgres (FASTEST, zero install):
#   1. Go to https://neon.tech and sign up (free, no credit card)
#   2. Create a project — you'll get a connection string like:
#      postgresql://user:pass@ep-xxx.region.aws.neon.tech/patafundi?sslmode=require
#   3. Paste it as DATABASE_URL below.
#   Works instantly on Windows/Mac/Linux. Free tier: 0.5 GB storage, plenty for dev.
#
# OPTION B — Docker Postgres (if you have Docker Desktop installed):
#   1. Run:  docker compose up -d
#   2. Use:  DATABASE_URL=postgres://postgres:postgres@localhost:5432/patafundi
#
# OPTION C — Local Postgres install:
#   1. Install Postgres 16+ from https://www.postgresql.org/download/windows/
#   2. Create database:  createdb patafundi  (or via pgAdmin)
#   3. Use:  DATABASE_URL=postgres://postgres:postgres@localhost:5432/patafundi
#
# OPTION D — Mac/Linux only: leave DATABASE_URL empty to use PGlite (embedded DB).
#   PGlite may NOT work on Windows — if you see "Aborted(). Build with -sASSERTIONS",
#   switch to Option A (Neon, free, 30 seconds) or Option B (Docker).
DATABASE_URL=

# Auth secrets (generate unique values for production)
JWT_SECRET=dev-jwt-secret-change-in-production
REFRESH_TOKEN_SECRET=dev-refresh-secret-change-in-production
COOKIE_SECURE=false

# Email OTP (Resend — use sandbox sender until domain is verified)
RESEND_API_KEY=
EMAIL_FROM=onboarding@resend.dev

# Location provider: false = OpenStreetMap (free), true = Google Maps (requires keys below)
USE_GOOGLE_MAPS=false

# Google Maps server-side geocoding/directions
GOOGLE_MAPS_SERVER_KEY=

# M-Pesa Daraja (required for real payments)
MPESA_BASE_URL=https://api.safaricom.co.ke
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=
MPESA_PASSKEY=
MPESA_CALLBACK_URL=
MPESA_CALLBACK_SECRET=
MPESA_TIMEOUT_URL=
MPESA_RESULT_URL=

# Cloudflare R2 storage (production — local fallback when unset)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=patafundi
# R2_PUBLIC_URL is optional; files are never served publicly — use signed URLs only
R2_PUBLIC_URL=

# Optional: AWS Rekognition for production-grade face matching (set to true when configured)
AWS_REGION=us-east-1
AWS_REKOGNITION_ENABLED=false

# ── PII encryption (AES-GCM for phone numbers etc.) ───────────────────────────
# REQUIRED in production — 32+ char random string. If unset, PII is stored
# plaintext (dev convenience only; server logs a warning).
ENCRYPTION_KEY=

# ── Server runtime (documented for completeness) ─────────────────────────────
# Bind host (default 0.0.0.0 in production, 127.0.0.1 in dev)
HOST=
# Force embedded PGlite DB (1) even when DATABASE_URL is present — dev/CI only
PATAFUNDI_EMBEDDED_DB=
# Custom PGlite data directory (default backend/.pgdata)
PATAFUNDI_PGDATA_DIR=
# Backups directory for enterprise DR tooling (default backend/backups)
BACKUP_DIR=
# User-Agent for OpenStreetMap Nominatim geocoding (required politeness policy)
NOMINATIM_USER_AGENT=PataFundi/1.0 (support@patafundi.com)
# Firebase Cloud Messaging (push notifications; local/dev fallback is no-op)
FCM_SERVER_KEY=
FIREBASE_PROJECT_ID=
# Deployment metadata shown in /health (optional)
RENDER_GIT_COMMIT=
GIT_COMMIT=
RENDER_DEPLOY_ID=

# ── Mobile apps (apps/customer-mobile, apps/fundi-mobile) ────────────────────
# Expo apps read these via EXPO_PUBLIC_* env vars at bundle time (never hardcode
# hosts in source — real devices must point at a reachable origin):
#   EXPO_PUBLIC_API_URL — full API origin, e.g. https://patafundi-9bhsw1.onrender.com
#   EXPO_PUBLIC_HOST    — host for local dev, resolves to http://<host>:4000
# Falls back to the production Render origin when both are unset.
EXPO_PUBLIC_API_URL=
EXPO_PUBLIC_HOST=

# Demo accounts (created by npm run db:seed — full list in DEMO_ACCOUNTS.md)
# Customer: demo@patafundi.com / Demo@2024!
# Fundi:    fundi@patafundi.com / Fundi@2024!
# Admin:    admin@patafundi.com / Admin@2024!
# Owner:    emmanuelevian@gmail.com / PataFundiOwner@2026 (DEV ONLY — prod uses bootstrap-owner.js)

# ── AI Assistant (spec §31) ─────────────────────────────────────────────────
# The AI service runs server-side via the bundled z-ai SDK (no key needed in
# this sandbox). If you swap in another LLM provider, put its key here and
# wire it in backend/src/services/llmService.js only — NEVER in frontend code.
AI_API_KEY=

# ── Platform owner bootstrap (production) ───────────────────────────────────
# backend/scripts/bootstrap-owner.js creates emmanuelevian@gmail.com as
# super_admin. Set OWNER_PASSWORD explicitly (10+ chars). Do NOT enable the
# print option in production — credentials in logs are an audit finding.
OWNER_PASSWORD=
OWNER_PRINT_PASSWORD=

# ── SMS notifications (optional; central notification service §27) ──────────
# Africa's Talking OR Twilio. When set, queued sms_notification jobs deliver.
AFRICAS_TALKING_API_KEY=
AFRICAS_TALKING_USERNAME=
TWILIO_ACCOUNT_SID=
TWILIO_ACCOUNT_TOKEN=
